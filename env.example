# Supabase 接続情報。このファイルを `.env.local` にコピーして値を入れる。
# ローカル開発なら `supabase start` の出力に表示される API URL / anon key を使う。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google カレンダー接続(Epic 3)。Google Cloud で作った OAuth クライアント ID(公開値)。
# 手順は docs/google-connection-setup.md。クライアントシークレットはここには書かない
# (Supabase の関数シークレットにだけ入れる。AD-3)。
VITE_GOOGLE_OAUTH_CLIENT_ID=
# 広告。既定はAndroid。iOSビルドはiosを明示し、対象OSへcap syncする。
VITE_ADMOB_PLATFORM=android
VITE_ADMOB_MODE=test
ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
# iOSもUMP検証用に自分のApp IDを指定可。空欄なら公式iOSテストApp ID。
# テストモードのバナーはこの指定に関係なく公式iOSテストバナーを使う。
ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_BANNER_ID=
VITE_PRIVACY_POLICY_URL=
# UMP検証用。自分のApp IDに公開したメッセージとテスト端末を使う。
VITE_ADMOB_DEBUG_EEA=false
VITE_ADMOB_TEST_DEVICE_IDS=
